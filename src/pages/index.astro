---
import Layout from '../layouts/layout.astro'
import Card from '../components/Card.astro'
import Hero from '../components/Hero.astro'
import ButtonEmail from '../components/ButtonEmail.astro'
import Button from '../components/Button.astro'

import { useTranslations } from '../i18n/utils'
import { defaultLang } from '../i18n/ui'
import { actions } from 'astro:actions'
import type { Project } from '@/types'
import c from '../content'

import getUrl from '@/utils/getUrl'
import List from '@/components/List.astro'
import ListItem from '@/components/ListItem.astro'
import CardPricing from '@/components/CardPricing.astro'
import Technologies from '@/components/Technologies.astro'

const lang = Astro.currentLocale ?? defaultLang
const t = useTranslations(lang)

const { data: projects = [] } = await Astro.callAction(actions.getProjects, {})
const featuredProjects = projects.filter((project: Project) => project.featured)
---

<Layout>
  <Hero />
  <section class="l-container l-container--wide">
    <h2>{ t('home.services.title') }</h2>

    <div class="l-cards">
      {
        t('home.services.items').map((service) => (
          <Card tag={service.tag} title={service.title} template="default">
            <p>{service.description}</p>
          </Card>
        ))
      }
    </div>

    <ButtonEmail />

  </section>

  <!-- Pojects -->
  <section class="l-container">
    <h2>{ t('home.projects.title') }</h2>
    <div class="l-cards l-cards--wide">

      {featuredProjects.map((project: Project) => (
        <Card
          role={project.role}
          title={project.title}
          imageSrc={project.image || undefined}
          imageWidth={project.imageWidth}
          imageHeight={project.imageHeight}
          isImageScrollable={project.isImageScrollable}
          template="default"
        >
          <p set:html={project.description}></p>
          {
            project.url ? (
            <div>
              <a href={project.url} target="_blank">{project.url.replace('https://', '')}</a>
            </div>
            ) : ''
          }
        </Card>
      ))}
    </div>

    <Button href={getUrl('projects', lang)}>{t('home.projects.button')}</Button>
  </section>

  <!-- Pricing -->
  <section class="l-container">
    <h2>{ t('home.pricing.title') }</h2>
    <div class="l-cards">

      {
        t('home.pricing.levels').map((level) => (
          <CardPricing
            title={level.title}
            subTitle={level.description}
            price={level.price}
          >
            <List>
              {
                level.features.map((feature) => (
                  <ListItem>{feature}</ListItem>
                ))
              }
            </List>
          </CardPricing>
        ))
      }
    </div>
  </section>

  <!-- Brands -->
  <section class="l-container l-container--wide">
    <h2>{ t('home.brands.title') }</h2>
    <ul class="l-row l-row--wrap">
      {
        c.brands.map((brand) => (
          <li>
            <img class="c-logo" src={`/media/brands/${brand.logo}.svg`} alt={brand.name} title={brand.name} loading="lazy" />
          </li>
        ))
      }
      <li>
        { t('andmore') }
      </li>
    </ul>
  </section>

  <!-- Technologies -->
  <section class="l-container l-container--wide">
    <h2>{ t('home.technologies.title') }</h2>

    <Technologies />
  </section>

  <section class="l-container">
    <h2>{ t('interested') }</h2>
    <div>
      <ButtonEmail />
    </div>
  </section>
</Layout>

<style is:global>
main {
  margin-block-start: 0;
}
.header {
  position: absolute;
  z-index: 1;
  left: 0;
  width: 100%;
  background-color: transparent !important;
}
</style>
