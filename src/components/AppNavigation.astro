---
import { useTranslations } from '../i18n/utils'
import { defaultLang } from '../i18n/ui'
import getUrl from '@/utils/getUrl'

const lang = Astro.currentLocale ?? defaultLang
const t = useTranslations(lang)

const pathname = Astro.url.pathname

const pages = [
  {
    name: t('navigation.home'),
    href: getUrl('', lang),
    external: false,
  },
  {
    name: t('navigation.work'),
    href: getUrl('work', lang),
    external: false,
  },
  {
    name: t('navigation.meeting'),
    href: getUrl('meeting', lang),
    external: true,
  },
]

function isActive(href: string) {
  if (href === '/' || href === '/en') {
    return pathname === href || pathname === `${href}/`
  }
  return pathname.startsWith(href)
}
---

<nav>
  <ul>
    {
      pages.map(page => (
        <li class={isActive(page.href) ? 'active' : ''}>
          <a href={page.href} target={page.external ? '_blank' : '_self'}>{page.name}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
ul {
  display: flex;
  gap: var(--sl-spacing-large);
  @media (max-width: 1000px) {
    gap: var(--sl-spacing-small);
  }
  @media (max-width: 700px) {
    gap: var(--sl-spacing-medium);
  }
}
a {
  font-size: 1.8rem;
  text-decoration: none;
}
.active a {
  cursor: default;
  font-weight: bold;
}
</style>