---
import Card from './Card.astro'
import CardHeading from './CardHeading.astro'
import { actions } from 'astro:actions'
import type { Technology, TechnologyType } from '@/types'

const { data: technologies = [] } = await Astro.callAction(actions.getTechnologies, {})
const { data: technologyTypes = [] } = await Astro.callAction(actions.getTechnologyTypes, {})

const groupedTechnologies: any[] = []

technologyTypes.forEach((type: TechnologyType) => {
  const techs = technologies.filter((tech: Technology) => tech.type === type.slug)
  const techs2 = techs.map((tech: Technology) => ({
    name: tech.name,
    slug: tech.slug,
    website: tech.website,
    logo: tech.logo,
  }))

  groupedTechnologies.push({
    title: type.title,
    description: type.description,
    slug: type.slug,
    technologies: techs2
  })
})

---
<ul class="technologies">
  {
    groupedTechnologies.map((type: any) => (
      <li>
        <Card gap="m">
          <div class="technology__header">
            <CardHeading>{ type.title }</CardHeading>
            <p>{ type.description }</p>
          </div>
          <ul class="l-row l-row--small l-row--wrap">
            {
              type.technologies.map((tech: any) => (
                <li>
                  <a href={tech.website} target="_blank">
                    <img
                      class="technology__logo"
                      src={tech.logo}
                      alt={tech.name}
                      title={tech.name}
                      width="50"
                      height="50"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </Card>
      </li>
    ))
  }
</ul>

<style is:global>
.technologies .card {
  align-items: center;
}
</style>
<style>
.technologies {
  display: flex;
  gap: var(--spacing-m);
  flex-wrap: wrap;
  justify-content: center;
}
.technology__header {
  max-width: 18rem;
  padding-inline-end: var(--spacing-s);
  border-inline-end: 1px solid var(--color-primary-50);
}
.technology__logo {
  max-width: 5rem;
  max-height: 5rem;
  width: 100%;
}
@media (max-width: 1599px) {
  .technology__logo {
    max-width: 5rem;
    max-height: 5rem;
  }
}
@media (min-width: 1600px) {
  .technology__logo {
    max-width: 7rem;
    max-height: 7rem;
  }
  .technology__header {
    max-width: 25rem;
    padding-inline-end: var(--spacing-m);
  }
}
@media (max-width: 980px) {
  .technology__header {
    width: 100%;
    max-width: none;
    padding-inline-end: 0;
    border-inline-end: none;
    padding-block-end: var(--spacing-s);
    border-block-end: 1px solid var(--color-primary-50);
  }
}
@media (max-width: 768px) {
  .technologies > li {
    width: 100%;
    max-width: 500px;
  }
}
</style>