---

import Card from './Card.astro'
import { useTranslations } from '../i18n/utils'
import Price from './Price.astro'
import ButtonEmail from './ButtonEmail.astro'

const t = useTranslations(Astro.currentLocale)

interface Props {
	title: string
	subTitle: string
  price?: number
}


const {
	title,
	subTitle,
  price
} = Astro.props as Props
---


<Card
  class="card-pricing"
  title={ title }
  subTitle={ subTitle }
  template="default"
>
  <div class="card-pricing__content">
    <slot></slot>
  </div>
  <div class="card-pricing__footer">
    {
      price ? (
        <Price value={ price } isFrom={true} />
      ) : (
      <span>{t('home.pricing.customPrice')}</span>
      )
    }
    <ButtonEmail
      subject={`Website ${title}`}
      size="xs"
    />
  </div>
</Card>

<style scoped>
.card-pricing {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-m);
}
.card-pricing__content {
  padding-block: var(--spacing-m);
  border-block: 1px solid var(--color-neutral-300);
  flex-grow: 1;
}
.card-pricing__footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: var(--spacing-s);
}
</style>