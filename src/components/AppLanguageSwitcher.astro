---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { languages, defaultLang, type SupportedLanguage } from '../i18n/ui'
import { pageTranslation } from '@/pages'

const currentLang = (Astro.currentLocale ?? defaultLang) as SupportedLanguage
const pathname = Astro.url.pathname

// Remove locale prefix to get the clean slug of current page
const langPrefix = currentLang === defaultLang ? '' : `/${currentLang}`
const cleanPath = pathname.replace(langPrefix, '').replaceAll('/', '')

function getURL(targetLang: string) {
  if (targetLang === currentLang) return pathname
  const translatedPath = (pageTranslation as Record<string, string>)[cleanPath] || cleanPath
  return getRelativeLocaleUrl(targetLang, translatedPath)
}
---
<ul>
  {Object.entries(languages).map(([lang]) => (
    <li>
      <a href={getURL(lang)} class={lang === currentLang ? 'active' : ''}>{lang}</a>
    </li>
  ))}
</ul>

<style>
ul {
  display: flex;
  text-transform: uppercase;
  white-space: nowrap;
  margin-inline-end: calc(var(--spacing-s) * -1);
}
li:not(:last-child)::after {
  content: "|";
}
a {
  padding: var(--spacing-s);
}
.active {
  text-decoration: none;
  font-weight: bold;
  cursor: default;
}
@media (max-width: 600px) {
  a {
    font-size: 1.6rem;
  }
}
</style>