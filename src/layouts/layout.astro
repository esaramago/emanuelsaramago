---
import { Font } from 'astro:assets'
import '../css/main.css'
import Header from '../components/AppHeader.astro'
import Footer from '../components/AppFooter.astro'

import { getLangFromUrl, useTranslations } from '../i18n/utils'

const currentLang = getLangFromUrl(Astro.url)
const t: any = useTranslations(currentLang)
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <Font cssVariable="--font-montserrat" />
    <title>Emanuel Saramago | {t('title')}</title>

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t('description')} />
    <meta
      name="keywords"
      content="Portfolio, Webdesign, Websites, Webdevelopment, Design, Vue.js"
    />
    <meta name="author" content="esaramago" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="emanuelsaramago.com" />
    <meta property="og:title" content={t('title')} />
    <meta property="og:description" content={t('description')} />
    <meta property="og:image" content="/img/icons/meta.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="emanuelsaramago.com" />
    <meta property="twitter:title" content={t('title')} />
    <meta property="twitter:description" content={t('description')} />
    <meta property="twitter:image" content="/img/icons/meta.png" />

    <meta name="generator" content={Astro.generator} />

    <script
      is:inline
      defer
      src="https://analytics.emanuelsaramago.com/script.js"
      data-website-id="8b4bb724-0db5-4ad2-9fe9-fd453bc10c58"></script>
  </head>
  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
